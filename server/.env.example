# ==========================================
# OmniMedia Studio - Backend Server Environment Variables Example
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# If MongoDB is not running locally, the server automatically uses the built-in resilient JSON store
MONGODB_URI=mongodb://127.0.0.1:27017/multimedia_editor
MONGO_PORT=27017

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend Client Origin(s) for CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# File Upload Limit in Megabytes
MAX_UPLOAD_SIZE_MB=100
